{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Face: build",
      "type": "shell",
      "command": "${workspaceFolder}/tools/idf.ps1",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Face: flash COM3",
      "type": "shell",
      "command": "& './tools/idf.ps1' -IdfArgs @('-p','COM3','flash')",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Face: monitor COM3",
      "type": "shell",
      "command": "& './tools/idf.ps1' -IdfArgs @('-p','COM3','monitor')",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
