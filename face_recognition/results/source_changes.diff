+static void unrotate(int &x, int &y, int rotation)
+{
+    int u = x, v = y;
+    if (rotation == 90) { x = v; y = DETECT_HEIGHT - 1 - u; }
+    else if (rotation == 180) { x = DETECT_WIDTH - 1 - u; y = DETECT_HEIGHT - 1 - v; }
+    else if (rotation == 270) { x = DETECT_WIDTH - 1 - v; y = u; }
+}
